      "@api": ["./src/api"],
      "@components/*": ["./src/components/*"],
      "@config/*": ["./src/config/*"],
      "@config": ["./src/config"],
      "@helpers/*": ["./src/helpers/*"],
      "@hooks": ["./src/hooks"],
