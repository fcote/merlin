{
  "name": "merlin-server",
  "version": "0.1.0",
  "description": "Merlin server",
  "author": "Fabien COTE",
  "license": "GPL-3.0",
  "main": "index.ts",
  "scripts": {
    "copy:config": "ts-node scripts/copyConfig.ts",
    "seed:accounts": "ts-node scripts/seedAccounts.ts",
    "build-ts": "tsc --build tsconfig.json",
    "build": "npm run build-ts && npm run copy:config",
    "start": "node -r ./tsconfig.paths.js ./index.js",
    "start:dev": "TS_NODE_FILES=true SKIP_AUTH=true nodemon --watch 'src/**/*' -e ts,tsx --exec ts-node -r tsconfig-paths/register index.ts",
    "start:debug": "TS_NODE_FILES=true SKIP_AUTH=true ts-node --inspect=9000 --debug-brk --ignore false -r tsconfig-paths/register index.ts",
    "start:noauth": "SKIP_AUTH=true ts-node -r tsconfig-paths/register index.ts",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts'",
    "migrate:dev": "HABX_ENV=local DEBUG=knex:tx knex migrate:latest --knexfile knexfile.ts",
    "migrate:dev:rollback": "HABX_ENV=local knex migrate:rollback --knexfile knexfile.ts",
    "migrate:dev:make": "knex migrate:make --migrations-directory ./migrations -x ts",
    "migrate": "knex migrate:latest --migrations-directory migrations --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --migrations-directory migrations --knexfile knexfile.js",
    "test": "npm run build && cd dist && SERVER_PORT=0 node -r ./tsconfig.paths.js --test --test-concurrency=1 ../test/*.cjs"
  },
  "dependencies": {
    "@graphql-tools/utils": "12.0.1",
    "@graphql-yoga/plugin-apq": "3.24.1",
    "@graphql-yoga/subscription": "5.1.1",
    "@koa/cors": "5.0.0",
    "@sentry/node": "10.75.1",
    "@sindresorhus/string-hash": "2.0.0",
    "convict": "6.2.5",
    "cron-parser": "5.10.1",
    "dataloader": "2.2.3",
    "dayjs": "1.11.23",
    "got": "16.0.0",
    "graphql": "17.0.2",
    "graphql-scalars": "2.0.0",
    "graphql-ws": "6.2.2",
    "graphql-yoga": "5.24.1",
    "jsdom": "30.1.1",
    "knex": "3.3.0",
    "koa": "3.2.1",
    "koa-bodyparser": "4.4.1",
    "lodash": "4.18.1",
    "node-fetch": "3.3.2",
    "node-schedule": "2.1.1",
    "numeral": "2.0.6",
    "object-hash": "3.0.0",
    "objection": "3.1.5",
    "p-map": "7.0.8",
    "pg": "8.23.0",
    "tough-cookie": "6.0.2",
    "tsconfig-paths": "4.2.0",
    "uuid": "14.0.2",
    "winston": "3.19.0",
    "winston-transport": "4.9.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/convict": "6.1.6",
    "@types/jsdom": "30.0.0",
    "@types/koa": "3.0.3",
    "@types/koa-bodyparser": "4.3.13",
    "@types/koa__cors": "5.0.1",
    "@types/lodash": "4.17.25",
    "@types/node": "26.6.2",
    "@types/node-schedule": "2.1.8",
    "@types/numeral": "2.0.5",
    "@types/object-hash": "3.0.6",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-helpers": "2.0.2",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.12.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.8",
    "ts-node": "10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=24.0.0 <27"
  }
}
